import shutil
import subprocess

include: "rules/common.smk"

paths = build_paths()
GENOMES = get_samples(paths)

# Copy the config file into the log directory
paths["LOG_DIR"].mkdir(parents=True)
shutil.copy(workflow.configfiles[0], paths["LOG_DIR"] / "input_config.yaml")

rule all:
    input:
        get_inputs_for_all(paths)

rule check_antismash:
    output: paths['OUT_DIR'] / ".antismash.ok"
    conda: get_antismash_env()
    log: paths['LOG_DIR'] / "check_antismash.log"
    script:
        "scripts/check_antismash.py"


rule run_antismash:
    input:
        genomes = f"{paths['IN_DIR']}/{{GENOMES}}.{config['in_ext']}",
        annotations = f"{paths['IN_DIR']}/{{GENOMES}}.{config.get('antismash_annotation_ext')}" \
            if config.get('antismash_annotation_ext') else [],
        antismash_ok = paths['OUT_DIR'] / ".antismash.ok"
    params:
        # config values are accessed directly by the script
        fail_log = paths['LOG_DIR'] / "antismash_errors.log",
    output:
        out_dir = directory(f"{paths['AS_DIR']}/{{GENOMES}}"),
        out_json = f"{paths['AS_DIR']}/{{GENOMES}}/{{GENOMES}}.json"  # Ensure the run finishes
    conda: get_antismash_env()
    log: paths['LOG_DIR'] / "antismash" / f"{{GENOMES}}.log"
    script:
        "scripts/run_antismash.py"

rule report:
    input: expand(f"{paths['AS_DIR']}/{{genomes}}/{{genomes}}.json", genomes = GENOMES)
    params:
        asdir = paths['AS_DIR']
    output: f"{paths['OUT_DIR']}/all_regions.tsv"
    shell: "multismash report {params.asdir} {output}"

rule count:
    input: expand(f"{paths['AS_DIR']}/{{genomes}}/{{genomes}}.json", genomes = GENOMES)
    params:
        asdir = paths['AS_DIR'],
        contig = "--by_contig" if config["count_per_contig"] else "",
        hybrid = "--split_hybrids" if config["split_hybrids"] else ""
    output: f"{paths['OUT_DIR']}/region_counts.tsv"
    shell: "multismash count {params.asdir} {output} {params.contig} {params.hybrid}"


## BiG-SCAPE rules

if config["run_bigscape"]:
    BIG_ENV, BIG_COMMAND, BIG_PFAM = get_bigscape_env()

    rule run_bigscape:
        input: expand(f"{paths['AS_DIR']}/{{genomes}}/{{genomes}}.json", genomes = GENOMES)
        params:
            asdir = paths['AS_DIR'],
            outdir = paths['BIG_DIR'],
            bigscape_command = BIG_COMMAND,
            pfam_dir = BIG_PFAM,
            bigscape_flags = config['bigscape_flags'] if config['bigscape_flags'] else "",
            cores = f"-c {config['cores']}" if isinstance(config['cores'], int) else ""
        output:
            f"{paths['BIG_DIR']}/index.html"
        conda: BIG_ENV
        shell: "{params.bigscape_command} -i {params.asdir} -o {params.outdir}"
                " {params.cores} --pfam_dir {params.pfam_dir} {params.bigscape_flags}"

    rule tar_bigscape:
        input: f"{paths['BIG_DIR']}/index.html"
        params: paths['BIG_DIR']
        output: f"{paths['BIG_DIR']}.tar.gz"
        shell: "tar --exclude 'cache' -zcf {output} -C {params} ."
